# ─────────────────────────────────────────────────────────────
# Variables d'environnement – copiez ce fichier en ".env.local"
# (en local) et renseignez les mêmes variables dans Vercel.
# ─────────────────────────────────────────────────────────────

# URL publique du site (sans slash final). Sert au sitemap, aux balises Open Graph, etc.
NEXT_PUBLIC_SITE_URL=https://www.piscinefacile.fr

# Clé API Resend (https://resend.com → API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Adresse qui reçoit les demandes de devis
QUOTE_TO_EMAIL=contact@votre-domaine.fr

# Adresse d'expédition. Doit appartenir à un domaine vérifié dans Resend.
# Pour vos tests, "onboarding@resend.dev" fonctionne (envoi uniquement vers votre propre adresse Resend).
QUOTE_FROM_EMAIL=PiscineFacile <devis@votre-domaine.fr>

# ── Pages « électricien piscine » ─────────────────────────────
# Adresse qui reçoit les demandes « Électricité » situées dans VOTRE zone (config/serviceArea.ts).
# Facultatif : si vide, ces demandes arrivent à QUOTE_TO_EMAIL avec la mention [Ma zone].
QUOTE_ZONE_EMAIL=

# ── Rappels d'entretien par e-mail (double opt-in) ───────────
# Chaîne aléatoire longue (au moins 32 caractères) qui signe les liens de confirmation.
NEWSLETTER_SECRET=remplacez-par-une-longue-chaine-aleatoire
# Identifiant du segment Resend où ajouter les inscrits (Resend → Audience → Segments). Facultatif.
RESEND_SEGMENT_ID=
# Expéditeur des e-mails de confirmation (par défaut : QUOTE_FROM_EMAIL)
NEWSLETTER_FROM_EMAIL=

# ── Référencement ─────────────────────────────────────────────
# Code de vérification Google Search Console (méthode « balise HTML », valeur de content="…")
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Code de vérification Bing Webmaster Tools
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Mesure d'audience sans cookie (facultatif, une seule suffit) ──
# Plausible : votre domaine tel que déclaré dans Plausible
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Umami : identifiant du site et adresse du script
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=
